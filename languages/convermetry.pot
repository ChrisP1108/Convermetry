msgid "<strong>sessions</strong> in which the form scrolled into view"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2048
#: src/Admin/Pages/AboutPage.php:2049
#: src/Admin/Pages/AboutPage.php:2050
#: src/Admin/Pages/AboutPage.php:2052
msgid "browser-observed"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2049
#: src/Admin/Pages/FormsPage.php:404
msgid "Started"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2049
msgid "<strong>sessions</strong> in which someone began filling it in"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2050
msgid "<strong>raw submit presses</strong> — one visitor fighting a validation error produces several, which is the point"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2051
#: src/Admin/Pages/FormsPage.php:383
#: src/Admin/Pages/FormsPage.php:406
msgid "Successful"
msgstr ""

#: src/Admin/Pages/AboutPage.php:2051
