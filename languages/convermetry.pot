#: src/Admin/Pages/AboutPage.php:2694
#, php-format
msgid "Convermetry exposes a public hook API for plugins and code snippets — <strong>%d hook</strong> in all. Two rules hold across every one of them."
msgid_plural "Convermetry exposes a public hook API for plugins and code snippets — <strong>%d hooks</strong> in all. Two rules hold across every one of them."
msgstr[0] ""
