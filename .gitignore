# The test toolchain IS tracked here — `tests/`, `composer.json`, and
# `phpunit.xml` are version-controlled so the suite is reviewable and runnable
# from a clone. They never reach the distributed plugin: `.distignore` and
# `bin/build-zip.sh` strip them from the release ZIP, and the build fails if one
# leaks. Only generated/installed artifacts are ignored.
/vendor/
/.phpunit.cache/
/build/
composer.lock
.DS_Store
