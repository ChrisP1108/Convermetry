# Copy to .env.svn and run: chmod 600 .env.svn
# Use your separate WordPress.org SVN password, not your website password.
# Values are literal. Optional surrounding quotes are removed; shell expressions
# and backslash escapes are never evaluated. Put comments on their own lines.
# Environment variables SVN_USERNAME / SVN_PASSWORD override this file.
SVN_USERNAME=your-wordpress-org-username
SVN_PASSWORD=your-svn-password
